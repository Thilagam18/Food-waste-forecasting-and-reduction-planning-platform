# ==============================================================================
# Food Waste Forecasting & Reduction Planning Platform - Environment Configuration
# ==============================================================================

# Flask Server Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_PORT=5000

# Security Keys (Generate strong random 64-char strings in production)
SECRET_KEY=fw-platform-super-secret-key-prod-2026-production-ready
JWT_SECRET_KEY=fw-platform-jwt-token-secret-key-secure-2026
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Database Configuration (MySQL / SQLite fallback)
# For MySQL local or production:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/food_waste_db
#
# If DATABASE_URL is not set or set to sqlite, local SQLite database is used automatically:
DATABASE_URL=sqlite:///food_waste.db

# Optional direct MySQL parameters if not using DATABASE_URL:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=food_waste_db

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:5000/api
