# MediSync Environment Variables

# Backend Config
SECRET_KEY=medisync-super-secret-key-change-in-production-2026
JWT_SECRET_KEY=medisync-jwt-secret-key-change-in-production-2026
FLASK_ENV=development
FLASK_PORT=5000

# Database Configuration
# Leave empty or set to sqlite:///medisync.db for zero-config local SQLite
# Or set MySQL URL: mysql+pymysql://username:password@localhost:3306/medisync
DATABASE_URL=sqlite:///medisync.db

# AI Integration
# Google Gemini API Key (Get from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Map Config
NEXT_PUBLIC_MAP_DEFAULT_LAT=12.9716
NEXT_PUBLIC_MAP_DEFAULT_LNG=77.5946
NEXT_PUBLIC_MAP_ZOOM=13
